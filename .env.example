# 播客 AI 精读/问答 & 谣言粉碎机（不填也能照常使用静态科普、字幕和一图读懂）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 可选：如果使用中转代理或兼容 OpenAI 协议的服务，填写 Base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选备用：谣言粉碎机支持 Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 站内真实提问/投稿实时接收（任选其一填到 Vercel 环境变量，全部免费）：
# 方案 A：飞书 / 企业微信 / Discord 群机器人 Webhook
# FEEDBACK_WEBHOOK_URL=
# 方案 B：Telegram Bot 实时直达私信（向 @BotFather 申请 token，@userinfobot 查 chat_id）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# 方案 C：自动在 GitHub 仓库建 Issue（需 repo Issues 写权限的 Fine-grained PAT）
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=nuts-and-bytes/health-heystone
